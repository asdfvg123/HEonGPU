diff --git a/src/include/ntt_merge/ntt_fast16.cuh b/src/include/ntt_merge/ntt_fast16.cuh
new file mode 100644
index 0000000..8587a59
--- /dev/null
+++ b/src/include/ntt_merge/ntt_fast16.cuh
@@ -0,0 +1,68 @@
+// Fast path for N = 2^16, 64-bit, X^N + 1 (no zero padding): radix-8 register
+// butterflies with Shoup multiplication and lazy reduction. Same two-pass data
+// flow and the same twiddle tables (Root<T>[m + (omega >> t)], bit-reversed
+// powers, N entries per prime) as the merge kernels, outputs fully reduced, so
+// the results are bit-identical to ForwardCore / InverseCore and their
+// ModulusOrdered / PolyOrdered variants.
+//
+// Enabled by GPUNTT_FAST16=1 (read once), or set_enabled() at run time.
+//
+// The Shoup companions of a twiddle table (and of an n^-1 array) are built on
+// the device once per table pointer and cached. Every kernel checks its prime's
+// cache entry against the live table and modulus (q and the last twiddle, which
+// determines the whole table) and, if the entry is missing or stale (a table
+// freed and reallocated at the same address with other contents), computes the
+// companions on the fly for that launch and asks the host to rebuild the cache
+// on the next call. A stale cache therefore costs speed, never correctness.
+#ifndef NTT_FAST16_H
+#define NTT_FAST16_H
+
+#include <cuda_runtime.h>
+#include "modular_arith.cuh"
+
+namespace gpuntt
+{
+    namespace fast16
+    {
+        typedef unsigned long long u64;
+
+        enum OrderMode
+        {
+            ORDER_NONE = 0, // limb z uses prime z % mod_count
+            ORDER_MODULUS = 1, // limb z uses prime order[z % mod_count]
+            ORDER_POLY = 2 // limb order[z] uses prime z % mod_count
+        };
+
+        struct Request
+        {
+            const u64* in;
+            u64* out;
+            const u64* table; // forward or inverse root table
+            const Modulus<u64>* modulus; // nullptr: single prime q_single
+            u64 q_single;
+            const u64* ninv; // inverse only; nullptr: single ninv_single
+            u64 ninv_single;
+            const int* order; // ORDER_MODULUS / ORDER_POLY only
+            int order_mode;
+            int batch;
+            int mod_count;
+            cudaStream_t stream;
+        };
+
+        // GPUNTT_FAST16 != 0, unless overridden with set_enabled.
+        bool enabled();
+        // 1: on, 0: off, -1: follow GPUNTT_FAST16 again.
+        void set_enabled(int value);
+        // Frees every cached Shoup table (synchronizes the device).
+        void clear_cache();
+
+        // Run the fast NTT / INTT. Returns false (and launches nothing) when the
+        // request is outside what the fast path covers; the caller then runs
+        // the generic kernels.
+        bool forward(const Request& request);
+        bool inverse(const Request& request);
+
+    } // namespace fast16
+} // namespace gpuntt
+
+#endif // NTT_FAST16_H
